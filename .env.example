# Copy to .env and edit. .env is git-ignored.

# Password you both type to get in. Use something long.
ROOM_PASSWORD=change-me-to-something-long

# Folder of movies on this Mac for the Library button.
MEDIA_DIR=~/Movies

# Port on this Mac (the tunnel points here).
PORT=3000

# For sites that need you logged in (age-restricted or members-only videos):
# log in to the site in that browser on this Mac, then set it here.
# YTDLP_COOKIES_BROWSER=chrome

# Set to 1 to skip the Cloudflare tunnel (only usable on this Mac).
# NO_TUNNEL=1

# Optional: GIF search in chat. Get a free key at https://developers.giphy.com (Create an App -> API).
# Searches and GIFs go through this Mac; phones never contact GIPHY directly.
# GIPHY_API_KEY=
